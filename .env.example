# Cloudinary Configuration
# Copy this file to .env and fill in your actual credentials
# IMPORTANT: Never commit .env to version control!

# Required: Your Cloudinary API credentials
# Get these from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME= v2v8c0fu
CLOUDINARY_API_KEY=374285775688633
CLOUDINARY_API_SECRET=_Wg1mKTOOlMxcoLAwc0mXGIpyCM

# Optional: Frontend-specific variables (uncomment as needed)
# These are safe to expose in client-side code

# For React/Vite applications
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# For Next.js applications
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# For Vue applications
# VUE_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Optional: Cloudinary Upload Presets (for widget-based uploads)
# CLOUDINARY_UPLOAD_PRESET=your_preset_name

# Optional: Folder for uploads (if using cloud)
# CLOUDINARY_FOLDER=your-app-folder

# Optional: Tags for uploads
# CLOUDINARY_TAGS=app-uploads,auto-generated

# ============================================
# IMPORTANT SECURITY NOTES:
# ============================================
# 1. CLOUDINARY_API_SECRET should NEVER be used in client-side code
# 2. Only CLOUDINARY_CLOUD_NAME (or VITE_/NEXT_PUBLIC_ prefixed vars) are safe for frontend
# 3. Keep this file in .gitignore
# 4. Use actual values instead of placeholders
# 5. Rotate your API keys regularly from the Console
#
# How to fill this file:
# 1. Go to https://console.cloudinary.com/settings/api-keys
# 2. Copy your Cloud Name
# 3. Copy your API Key
# 4. Copy your API Secret
# 5. Paste them below (replace "your_cloud_name" etc)
# 6. Save and restart your application
