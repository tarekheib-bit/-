        "sendTo": "[המייל שלך]",
        "subject": "=פנייה חדשה מהטופס — {{ $(\"נרמול נתונים\").item.json.name }}",
        "message": "=<div dir=\"rtl\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.7\"><h2 style=\"margin:0 0 12px\">פנייה חדשה מהטופס באתר</h2><table cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><td><b>שם</b></td><td>{{ $(\"נרמול נתונים\").item.json.name }}</td></tr><tr><td><b>טלפון</b></td><td>{{ $(\"נרמול נתונים\").item.json.phoneNumber }}</td></tr><tr><td><b>אימייל</b></td><td>{{ $(\"נרמול נתונים\").item.json.email }}</td></tr><tr><td><b>פרטים</b></td><td>{{ $(\"נרמול נתונים\").item.json.notes || \"—\" }}</td></tr><tr><td><b>מקור</b></td><td>{{ $(\"נרמול נתונים\").item.json.source }}</td></tr><tr><td><b>סטטוס</b></td><td>{{ $(\"נרמול נתונים\").item.json.status }}</td></tr><tr><td><b>התקבל</b></td><td>{{ $(\"נרמול נתונים\").item.json.timestamp }}</td></tr></table><p style=\"margin-top:16px;color:#666\">השורה כבר נוספה לגיליון הלידים.</p></div>",
        "options": {
          "appendAttribution": false,
          "senderName": "Focus AI Leads"
        }
