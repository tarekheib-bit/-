8,85,247,.22) !important;\n}\n\ntextarea{ min-height:110px !important; line-height:1.5; resize:vertical; }\n\nbutton, [type=\"submit\"]{\n  background:linear-gradient(135deg,#D946EF 0%,#A855F7 50%,#7C3AED 100%) !important;\n  color:#FFFFFF !important;\n  border:none !important;\n  border-radius:10px !important;\n  padding:14px 18px !important;\n  font-size:16px !important;\n  font-weight:700 !important;\n  letter-spacing:.01em;\n  width:100% !important;\n  cursor:pointer;\n  box-shadow:0 10px 26px -8px rgba(168,85,247,.65), 0 0 18px rgba(217,70,239,.30) !important;\n  transition:transform .12s ease, box-shadow .2s ease, filter .2s ease;\n}\n\nbutton:hover{\n  transform:translateY(-1px);\n  filter:brightness(1.06);\n  box-shadow:0 14px 32px -8px rgba(168,85,247,.75), 0 0 26px rgba(217,70,239,.45) !important;\n}\n\nbutton:active{ transform:translateY(0); }\n\nbutton *{ color:#FFFFFF !important; }\n"
