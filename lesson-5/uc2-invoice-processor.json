        "message": "=<div dir=\"rtl\" lang=\"he\" style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;max-width:600px;margin:0 auto;background:#f9fafb;color:#1f2937\">\n  <div style=\"background:linear-gradient(135deg,#dc2626 0%,#ef4444 100%);padding:28px;color:white;border-radius:12px 12px 0 0\">\n    <div style=\"font-size:13px;opacity:0.9;margin-bottom:8px\">🧾 התראת אישור</div>\n    <h1 style=\"margin:0;font-size:26px;font-weight:700\">⚠️ חשבונית גדולה דורשת אישור מנהל</h1>\n  </div>\n  <div style=\"background:white;padding:24px 28px;border-right:1px solid #e5e7eb;border-left:1px solid #e5e7eb\">\n    <div style=\"font-size:36px;font-weight:700;color:#991b1b;margin-bottom:6px\">{{ $('🧠 LLM Chain: Invoice Analysis').item.json.output.currency }} {{ $('🧠 LLM Chain: Invoice Analysis').item.json.output.amount }}</div>\n    <div style=\"font-size:14px;color:#6b7280;margin-bottom:24px\">חשבונית מ-{{ $('🧠 LLM Chain: Invoice Analysis').item.json.output.vendor }}</div>\n    <div style=\"display:flex;gap:16px;border-top:1px solid #f3f4f6;padding-top:20px\">\n      <div style=\"flex:1\"><div style=\"font-size:11px;color:#6b7280;letter-spacing:0.5px;margin-bottom:4px\">📅 תאריך</div><div style=\"font-size:15px;font-weight:600\">{{ $('🧠 LLM Chain: Invoice Analysis').item.json.output.date }}</div></div>\n      <div style=\"flex:1\"><div style=\"font-size:11px;color:#6b7280;letter-spacing:0.5px;margin-bottom:4px\">🏢 ספק</div><div style=\"font-size:15px;font-weight:600\">{{ $('🧠 LLM Chain: Invoice Analysis').item.json.output.vendor }}</div></div>\n    </div>\n    <div style=\"background:#fef3c7;border-right:4px solid #f59e0b;padding:14px 18px;border-radius:6px;margin-top:24px\">\n      <div style=\"font-size:13px;color:#92400e;line-height:1.6\"><strong>⚡ נדרש:</strong> בדיקת אישור מנהל ועדכון סטטוס ב-Sheet 'Approval Required'.</div>\n    </div>\n  </div>\n  <div style=\"background:#f9fafb;padding:14px 28px;border-radius:0 0 12px 12px;border:1px solid #